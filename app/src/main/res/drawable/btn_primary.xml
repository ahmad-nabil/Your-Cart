<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/btn_primary.xml -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#6070E0"
                android:endColor="#A060E0" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#7B8FFF"
                android:endColor="#C084FC" />
        </shape>
    </item>
</selector>
