<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ConstraintSet android:id="@+id/start">
        <Constraint android:id="@+id/gradient_bg">
            <PropertySet android:alpha="0" />
        </Constraint>
        <Constraint android:id="@+id/arc_top">
            <PropertySet android:alpha="0" />
            <Transform
                android:rotation="-90"
                android:translationX="-200dp"
                android:translationY="-200dp" />
        </Constraint>
        <Constraint android:id="@+id/arc_bottom">
            <PropertySet android:alpha="0" />
            <Transform
                android:rotation="90"
                android:translationX="200dp"
                android:translationY="200dp" />
        </Constraint>

        <Constraint android:id="@+id/dot1">
            <PropertySet android:alpha="0" />
            <Transform
                android:scaleX="0"
                android:scaleY="0" />
        </Constraint>
        <Constraint android:id="@+id/dot2">
            <PropertySet android:alpha="0" />
            <Transform
                android:scaleX="0"
                android:scaleY="0" />
        </Constraint>
        <Constraint android:id="@+id/dot3">
            <PropertySet android:alpha="0" />
            <Transform
                android:scaleX="0"
                android:scaleY="0" />
        </Constraint>
        <Constraint android:id="@+id/dot4">
            <PropertySet android:alpha="0" />
            <Transform
                android:scaleX="0"
                android:scaleY="0" />
        </Constraint>
        <Constraint android:id="@+id/dot5">
            <PropertySet android:alpha="0" />
            <Transform
                android:scaleX="0"
                android:scaleY="0" />
        </Constraint>
        <Constraint android:id="@+id/dot6">
            <PropertySet android:alpha="0" />
            <Transform
                android:scaleX="0"
                android:scaleY="0" />
        </Constraint>

        <Constraint android:id="@+id/glow_ring">
            <PropertySet android:alpha="0" />
            <Transform
                android:scaleX="0.2"
                android:scaleY="0.2" />
        </Constraint>
        <Constraint android:id="@+id/logo">
            <PropertySet android:alpha="0" />
            <Transform
                android:rotation="-180"
                android:scaleX="0"
                android:scaleY="0" />
            <Layout
                android:layout_marginBottom="80dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </Constraint>
        <Constraint android:id="@+id/tv_app_name">
            <PropertySet android:alpha="0" />
            <Transform android:translationY="50dp" />
        </Constraint>
        <Constraint android:id="@+id/tv_tagline">
            <PropertySet android:alpha="0" />
            <Transform android:translationY="40dp" />
        </Constraint>
        <Constraint android:id="@+id/divider">
            <PropertySet android:alpha="0" />
            <Transform android:scaleX="0" />
        </Constraint>
        <Constraint android:id="@+id/btn_shop_now">
            <PropertySet android:alpha="0" />
            <Transform
                android:scaleX="0.8"
                android:scaleY="0.8"
                android:translationY="80dp" />
            <Layout
                android:layout_marginBottom="100dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </Constraint>
        <Constraint android:id="@+id/tv_version">
            <PropertySet android:alpha="0" />
            <Transform android:translationY="20dp" />
        </Constraint>
    </ConstraintSet>
    <ConstraintSet android:id="@+id/end">
        <Constraint android:id="@+id/gradient_bg">
            <PropertySet android:alpha="1" />
        </Constraint>
        <Constraint android:id="@+id/arc_top">
            <PropertySet android:alpha="0.35" />
            <Transform
                android:rotation="0"
                android:translationX="0dp"
                android:translationY="0dp" />
        </Constraint>
        <Constraint android:id="@+id/arc_bottom">
            <PropertySet android:alpha="0.25" />
            <Transform
                android:rotation="0"
                android:translationX="0dp"
                android:translationY="0dp" />
        </Constraint>

        <Constraint android:id="@+id/dot1">
            <PropertySet android:alpha="0.9" />
            <Transform
                android:scaleX="1"
                android:scaleY="1" />
        </Constraint>
        <Constraint android:id="@+id/dot2">
            <PropertySet android:alpha="0.7" />
            <Transform
                android:scaleX="1"
                android:scaleY="1" />
        </Constraint>
        <Constraint android:id="@+id/dot3">
            <PropertySet android:alpha="0.8" />
            <Transform
                android:scaleX="1"
                android:scaleY="1" />
        </Constraint>
        <Constraint android:id="@+id/dot4">
            <PropertySet android:alpha="0.6" />
            <Transform
                android:scaleX="1"
                android:scaleY="1" />
        </Constraint>
        <Constraint android:id="@+id/dot5">
            <PropertySet android:alpha="0.75" />
            <Transform
                android:scaleX="1"
                android:scaleY="1" />
        </Constraint>
        <Constraint android:id="@+id/dot6">
            <PropertySet android:alpha="0.85" />
            <Transform
                android:scaleX="1"
                android:scaleY="1" />
        </Constraint>

        <Constraint android:id="@+id/glow_ring">
            <PropertySet android:alpha="0.6" />
            <Transform
                android:scaleX="1"
                android:scaleY="1" />
        </Constraint>
        <Constraint android:id="@+id/logo">
            <PropertySet android:alpha="1" />
            <Transform
                android:rotation="0"
                android:scaleX="1"
                android:scaleY="1" />
            <Layout
                android:layout_marginBottom="80dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </Constraint>
        <Constraint android:id="@+id/tv_app_name">
            <PropertySet android:alpha="1" />
            <Transform android:translationY="0dp" />
        </Constraint>
        <Constraint android:id="@+id/tv_tagline">
            <PropertySet android:alpha="1" />
            <Transform android:translationY="0dp" />
        </Constraint>
        <Constraint android:id="@+id/divider">
            <PropertySet android:alpha="1" />
            <Transform android:scaleX="1" />
        </Constraint>
        <Constraint android:id="@+id/btn_shop_now">
            <PropertySet android:alpha="1" />
            <Transform
                android:scaleX="1"
                android:scaleY="1"
                android:translationY="0dp" />
            <Layout
                android:layout_marginBottom="100dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </Constraint>
        <Constraint android:id="@+id/tv_version">
            <PropertySet android:alpha="0.5" />
            <Transform android:translationY="0dp" />
        </Constraint>
    </ConstraintSet>

