                app:motionTarget="@id/dot5" />
            <KeyAttribute
                android:alpha="0.75"
                android:rotation="20"
                android:scaleX="1.1"
                android:scaleY="1.1"
                app:framePosition="90"
                app:motionTarget="@id/dot5" />
            <KeyAttribute
                android:alpha="0.75"
                android:rotation="0"
                android:scaleX="1.0"
                android:scaleY="1.0"
                app:framePosition="100"
